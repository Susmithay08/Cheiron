# ---- LLM provider (used ONLY for query planning, never for factual data) ----
# Any OpenAI-compatible endpoint works.
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# ---- ClinicalTrials.gov API (public, no key required) ----
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
CTGOV_TIMEOUT_SECONDS=30
CTGOV_PAGE_SIZE=1000
# Hard cap on studies fetched per request (pagination safety valve)
CTGOV_MAX_STUDIES=3000
# In-process TTL cache for identical CT.gov requests (seconds, 0 disables)
CTGOV_CACHE_TTL_SECONDS=900

# ---- Service ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Max citations attached per visualized datum
MAX_CITATIONS_PER_DATUM=5
